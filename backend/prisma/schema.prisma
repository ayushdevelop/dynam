generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Form {
  id          String   @id @default(uuid())
  title       String
  description String?
  // Since sqlite doesn't support json arrays directly, we'll store JSON data as a String
  // In a real postgres db, this would be @db.JsonB
  fields      String   // Using plain String instead of Json to support SQLite simpler
  createdAt   DateTime @default(now())

  responses   Response[]
}

model Response {
  id        String   @id @default(uuid())
  formId    String
  // Using String to simulate JSONB in SQLite for simpler dev experience
  answers   String   
  createdAt DateTime @default(now())

  form      Form     @relation(fields: [formId], references: [id])
}
